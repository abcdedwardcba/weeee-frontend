{
  "routes": [
    { "src": "/reserve", "dest": "/reserve.html" },
    { "src": "/loyalty", "dest": "/loyalty.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
