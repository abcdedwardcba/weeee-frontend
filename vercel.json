{
  "rewrites": [
    { "source": "/reserve", "destination": "/reserve.html" },
    { "source": "/loyalty", "destination": "/loyalty.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *" }
      ]
    }
  ]
}
